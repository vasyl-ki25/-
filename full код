    </div><!-- /hero-dashboard -->
  </div>
</section>

<!-- ═══════════════════════════════ ABOUT ════════════════════════════════ -->
<section class="about" id="about">
  <div class="wrap">
    <p class="eyebrow">ABOUT</p>
    <h2 class="section-h" data-a="up">Boost the odds of card approval.</h2>
    <div class="about-grid" data-a="up" style="animation-delay:.1s">

      <div class="about-item">
        <div class="about-icon mono">( )<br>{ }</div>
        <h3>Link a bank account.</h3>
        <p>Petal quickly and securely uses bank data (policy and secure info) during the final application.</p>
      </div>

      <div class="about-item">
        <div class="about-icon mono">( )<br>( )</div>
        <h3>Show off financial history.</h3>
        <p>Petal can look beyond your credit score and consider responsible spending and saving behaviors.</p>
      </div>

      <div class="about-item">
        <div class="about-icon" style="font-size:26px">⚙</div>
