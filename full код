<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Petal — Get your help from our product</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
:root {
  --red:      #e53935;
  --red-dark: #c62828;
  --dark:     #111111;
  --dark2:    #1c1c1e;
  --gray-bg:  #f6f6f4;
  --gray-bd:  #e4e4e4;
  --gray-t:   #888888;
  --blue:     #1565c0;
  --blue-lt:  #e3eeff;
  --green:    #2e7d32;
  --white:    #ffffff;
  --text:     #1a1a1a;
  --font:     'DM Sans', sans-serif;
  --display:  'DM Serif Display', serif;
  --r-sm: 8px;
  --r-md: 16px;
  --r-lg: 24px;
  --r-xl: 32px;
  --sh-sm: 0 2px 8px rgba(0,0,0,.06);
  --sh-md: 0 8px 32px rgba(0,0,0,.10);
  --sh-lg: 0 24px 64px rgba(0,0,0,.13);
  --sh-red: 0 8px 28px rgba(229,57,53,.30);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: var(--font);
  color: var(--text);
  background: var(--white);
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}
a { text-decoration: none; color: inherit; }
ul { list-style: none; }

.wrap { max-width: 1100px; margin: 0 auto; padding: 0 28px; }

/* ── BUTTONS ── */
.btn-red {
  display: inline-flex; align-items: center; gap: 6px;
  background: var(--red); color: #fff;
  font-family: var(--font); font-size: 14px; font-weight: 600;
  padding: 10px 22px; border-radius: 50px; border: none; cursor: pointer;
  transition: background .22s, transform .18s, box-shadow .22s;
}
.btn-red:hover { background: var(--red-dark); transform: translateY(-2px); box-shadow: var(--sh-red); }
.btn-red.hero-cta { padding: 11px 28px; font-size: 14px; }

.btn-ghost {
  display: inline-flex; align-items: center;
  font-size: 14px; font-weight: 500; color: var(--gray-t);
  padding: 9px 16px; border-radius: 50px; border: none;
  background: transparent; cursor: pointer;
  transition: background .2s, color .2s;
}
.btn-ghost:hover { background: var(--gray-bg); color: var(--text); }

/* ── NAVBAR ── */
.nav {
  position: sticky; top: 0; z-index: 100;
  background: rgba(255,255,255,.97);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--gray-bd);
  transition: box-shadow .3s;
}
.nav.scrolled { box-shadow: var(--sh-md); }
.nav-inner { display: flex; align-items: center; height: 56px; }

.logo {
  display: flex; align-items: center; gap: 7px;
  font-family: var(--display); font-size: 17px; color: var(--dark);
  white-space: nowrap; flex-shrink: 0;
}
.logo-dot { width: 8px; height: 8px; background: var(--red); border-radius: 50%; flex-shrink: 0; }
.logo-lab { font-size: 11px; color: var(--gray-t); font-family: var(--font); margin-left: 3px; font-weight: 400; }

.nav-center {
  display: flex; align-items: center; gap: 2px;
  margin: 0 auto;
}
.nav-center a {
  font-size: 14px; font-weight: 500; color: var(--text);
  padding: 7px 14px; border-radius: 50px;
  display: flex; align-items: center; gap: 4px;
  transition: color .2s, background .2s;
}
.nav-center a:hover { background: var(--gray-bg); }
.nav-center .arrow { font-size: 10px; color: var(--gray-t); }
.nav-actions { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }

.burger {
  display: none; flex-direction: column; justify-content: center;
  gap: 5px; background: none; border: none; cursor: pointer;
  padding: 6px; margin-left: auto;
}
.burger span {
  display: block; width: 22px; height: 2px;
  background: var(--dark); border-radius: 2px;
  transition: transform .28s, opacity .2s;
}

/* ── HERO ── */
.hero {
  padding: 56px 0 48px;
  text-align: center;
  background: var(--white);
}
.hero h1 {
  font-family: var(--display);
  font-size: clamp(34px, 5.5vw, 64px);
  font-weight: 400; line-height: 1.1;
  color: var(--dark); margin-bottom: 10px;
}
.hero h1 .hl { color: var(--red); font-style: italic; }
.hero-sub {
  font-size: 14px; color: var(--gray-t); line-height: 1.6;
  max-width: 380px; margin: 0 auto 24px;
}
.hero-btns { display: flex; justify-content: center; gap: 12px; margin-bottom: 44px; }

/* Dashboard */
.hero-dashboard {
  background: #fff;
  border: 1px solid var(--gray-bd);
  border-radius: var(--r-xl);
  box-shadow: var(--sh-lg);
  max-width: 800px;
  margin: 0 auto;
  overflow: hidden;
}
.db-top {
  display: grid; grid-template-columns: repeat(3, 1fr);
  border-bottom: 1px solid var(--gray-bd);
  padding: 22px 28px; gap: 0;
}
.db-metric { text-align: left; }
.db-metric + .db-metric { border-left: 1px solid var(--gray-bd); padding-left: 28px; }
.db-metric-label {
  font-size: 11px; color: var(--gray-t); font-weight: 500;
  margin-bottom: 6px; text-transform: uppercase; letter-spacing: .06em;
}
.db-metric-val {
  font-family: var(--display);
  font-size: clamp(18px, 2.8vw, 26px);
  color: var(--dark); line-height: 1;
}
.db-metric-val.plus { color: #2e7d32; }
.db-metric-val.minus { color: var(--red); }

.db-charts { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
.db-chart-panel { padding: 18px 22px; border-right: 1px solid var(--gray-bd); }
.db-chart-panel:last-child { border-right: none; }
.db-chart-header {
  display: flex; justify-content: space-between; align-items: flex-start;
  margin-bottom: 4px;
}
.db-chart-title { font-size: 12px; font-weight: 600; color: var(--dark); margin-bottom: 2px; }
.db-chart-val { font-family: var(--display); font-size: 18px; color: var(--dark); margin-bottom: 3px; }
.db-chart-sub { font-size: 10px; color: var(--gray-t); margin-bottom: 10px; }
.db-ctrl-pill {
  background: var(--gray-bg); border: 1px solid var(--gray-bd); border-radius: 50px;
  padding: 3px 9px; font-size: 10px; color: var(--gray-t);
  display: inline-flex; align-items: center; gap: 3px;
}
.db-legend { display: flex; gap: 10px; margin-bottom: 8px; }
.db-legend span {
  font-size: 10px; color: var(--gray-t);
  display: flex; align-items: center; gap: 4px;
}
.db-legend-dot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; }

/* ── ABOUT ── */
.about { padding: 72px 0; background: var(--white); }
.eyebrow {
  text-align: center; font-size: 11px; text-transform: uppercase;
  letter-spacing: .14em; color: var(--gray-t); font-weight: 600; margin-bottom: 10px;
}
.section-h {
  font-family: var(--display);
  font-size: clamp(24px, 3.2vw, 38px);
  font-weight: 400; color: var(--dark); text-align: center;
  margin-bottom: 52px; line-height: 1.2;
}
.about-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 36px; }
.about-item { text-align: center; }
.about-icon {
  font-size: 30px; margin-bottom: 10px; color: var(--gray-t);
  line-height: 1.2;
}
.about-icon.mono {
  font-family: 'Courier New', monospace;
  font-size: 22px; color: var(--dark);
}
.about-item h3 { font-size: 14px; font-weight: 700; color: var(--dark); margin-bottom: 8px; }
.about-item p { font-size: 12px; color: var(--gray-t); line-height: 1.65; max-width: 220px; margin: 0 auto; }

/* ── PLANS ── */
.plans { padding: 72px 0; background: var(--gray-bg); }
.plans-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }

.plan-card {
  background: var(--white); border: 1px solid var(--gray-bd);
  border-radius: var(--r-md); padding: 22px;
  transition: transform .28s, box-shadow .28s;
}
.plan-card:hover { transform: translateY(-4px); box-shadow: var(--sh-md); }
.plan-card-top {
  display: flex; justify-content: space-between; align-items: flex-start;
  margin-bottom: 12px;
}
.plan-card-icon {
  width: 42px; height: 28px;
  background: linear-gradient(135deg, #1a237e, #283593);
  border-radius: 5px; position: relative; overflow: hidden; flex-shrink: 0;
}
.plan-card-icon::after {
  content: ''; position: absolute; right: 5px; bottom: 4px;
  width: 11px; height: 7px; background: rgba(255,215,0,.75); border-radius: 2px;
}
.plan-title { font-size: 15px; font-weight: 700; color: var(--dark); margin-bottom: 3px; }
.plan-sub { font-size: 11px; color: var(--gray-t); margin-bottom: 14px; line-height: 1.4; }

.plan-list { display: flex; flex-direction: column; gap: 0; margin-bottom: 18px; }
.plan-list li {
  display: flex; justify-content: space-between; align-items: center;
  font-size: 11px; padding: 7px 0;
  border-bottom: 1px solid var(--gray-bd);
}
.plan-list li:last-child { border-bottom: none; }
.pl-label { color: var(--gray-t); }
.pl-val { color: var(--dark); font-weight: 600; font-size: 11px; }
.pl-val.muted { color: var(--gray-t); font-weight: 400; }

.plan-btn-outline {
  display: block; text-align: center; width: 100%;
  padding: 10px 0; border-radius: 50px;
  font-family: var(--font); font-size: 13px; font-weight: 600;
  color: var(--dark); border: 1.5px solid var(--gray-bd);
  background: transparent; cursor: pointer;
  transition: border-color .2s, color .2s, transform .18s;
}
.plan-btn-outline:hover { border-color: var(--red); color: var(--red); transform: translateY(-1px); }

/* ── FEATURES (dark) ── */
.features {
  padding: 72px 0;
  background: var(--dark);
}
.features .eyebrow { color: #666; }
.features .section-h { color: #fff; margin-bottom: 40px; }

.features-grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.feat-item {
  padding: 26px;
  border: 1px solid #2a2a2a;
  border-radius: var(--r-md);
  background: #181818;
  transition: transform .28s, box-shadow .28s, border-color .28s;
}
.feat-item:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(0,0,0,.4); border-color: #3a3a3a; }
.feat-icon-wrap {
  width: 44px; height: 44px; border-radius: var(--r-sm);
  display: flex; align-items: center; justify-content: center;
  font-size: 20px; margin-bottom: 14px;
}
.feat-icon-wrap.r { background: rgba(229,57,53,.15); }
.feat-icon-wrap.b { background: rgba(21,101,192,.15); }
.feat-icon-wrap.g { background: rgba(46,125,50,.15); }
.feat-item h3 { font-size: 14px; font-weight: 700; color: #fff; margin-bottom: 8px; }
.feat-item p { font-size: 12px; color: #888; line-height: 1.65; }

/* ── REVIEWS ── */
.reviews { padding: 72px 0; background: var(--white); }
.reviews-row {
  display: grid; grid-template-columns: repeat(5, 1fr);
  gap: 12px; margin-bottom: 28px;
}
.rev-card {
  border: 1px solid var(--gray-bd); border-radius: var(--r-md);
  padding: 18px; background: var(--white);
  transition: box-shadow .28s, transform .28s;
}
.rev-card:hover { box-shadow: var(--sh-md); transform: translateY(-3px); }
.rev-stars { color: #ffc107; font-size: 11px; letter-spacing: 1px; margin-bottom: 8px; }
.rev-text {
  font-size: 11px; color: var(--gray-t);
  line-height: 1.6; font-style: italic; margin-bottom: 14px;
}
.rev-author { display: flex; align-items: center; gap: 8px; }
.rev-ava {
  width: 30px; height: 30px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 10px; font-weight: 700; color: #fff; flex-shrink: 0;
}
.ava1 { background: linear-gradient(135deg,#e53935,#ff7043); }
.ava2 { background: linear-gradient(135deg,#1565c0,#42a5f5); }
.ava3 { background: linear-gradient(135deg,#2e7d32,#66bb6a); }
.ava4 { background: linear-gradient(135deg,#6a1b9a,#ab47bc); }
.ava5 { background: linear-gradient(135deg,#e65100,#ff9800); }
.rev-author strong { display: block; color: var(--dark); font-size: 11px; font-weight: 600; }
.rev-author span { font-size: 10px; color: var(--gray-t); }

.reviews-nav { display: flex; justify-content: center; gap: 10px; }
.nav-arr {
  width: 36px; height: 36px; border-radius: 50%;
  border: 1.5px solid var(--gray-bd); background: var(--white);
  display: flex; align-items: center; justify-content: center;
  font-size: 15px; cursor: pointer; color: var(--dark);
  transition: border-color .2s, background .2s;
}
.nav-arr:hover { border-color: var(--dark); background: var(--gray-bg); }

/* ── FOOTER ── */
.footer {
  background: #f4f4f2; padding: 52px 0 24px;
  border-top: 1px solid var(--gray-bd);
}
.footer-grid {
  display: grid; grid-template-columns: 1.2fr 1fr 1fr 1.4fr;
  gap: 48px; margin-bottom: 36px; padding-bottom: 36px;
  border-bottom: 1px solid var(--gray-bd);
}
.footer-col h4 {
  font-size: 12px; font-weight: 700; color: var(--dark);
  margin-bottom: 14px; letter-spacing: .02em;
}
.footer-col ul { display: flex; flex-direction: column; gap: 9px; }
.footer-col a { font-size: 12px; color: var(--gray-t); transition: color .2s; }
.footer-col a:hover { color: var(--dark); }

.app-btns { display: flex; flex-direction: column; gap: 9px; }
.app-btn {
  display: flex; align-items: center; gap: 10px;
  border: 1.5px solid var(--gray-bd); border-radius: var(--r-sm);
  padding: 8px 14px; background: var(--white); cursor: pointer;
  transition: border-color .2s, box-shadow .2s;
  text-decoration: none;
}
.app-btn:hover { border-color: #aaa; box-shadow: var(--sh-sm); }
.app-btn-icon { font-size: 18px; }
.app-btn-text { display: flex; flex-direction: column; }
.app-btn-text small {
  font-size: 9px; color: var(--gray-t);
  text-transform: uppercase; letter-spacing: .06em;
}
.app-btn-text strong { font-size: 12px; font-weight: 700; color: var(--dark); }

.footer-bot {
  display: flex; justify-content: space-between; align-items: center;
  font-size: 11px; color: var(--gray-t); flex-wrap: wrap; gap: 8px;
}
.social-row { display: flex; gap: 7px; }
.soc-btn {
  width: 28px; height: 28px; border-radius: 50%;
  background: var(--white); border: 1px solid var(--gray-bd);
  display: flex; align-items: center; justify-content: center;
  font-size: 11px; color: var(--gray-t); cursor: pointer;
  text-decoration: none;
  transition: background .2s, color .2s, border-color .2s;
}
.soc-btn:hover { background: var(--dark); color: #fff; border-color: var(--dark); }

/* ── SCROLL ANIMATIONS ── */
[data-a] { opacity: 0; }
[data-a].in[data-a="up"]  { animation: aUp  .7s ease forwards; }
[data-a].in[data-a="pop"] { animation: aPop .6s ease forwards; }
@keyframes aUp  { from { opacity:0; transform:translateY(22px); } to { opacity:1; transform:none; } }
@keyframes aPop { from { opacity:0; transform:scale(.95); }        to { opacity:1; transform:none; } }

/* ── TABLET ── */
@media (max-width: 1024px) {
  .reviews-row { grid-template-columns: repeat(3, 1fr); }
  .footer-grid { grid-template-columns: 1fr 1fr; }
}

/* ── MOBILE ── */
@media (max-width: 640px) {
  .wrap { padding: 0 16px; }
  .hero { padding: 36px 0 28px; }
  .about, .plans, .features, .reviews { padding: 48px 0; }
  .section-h { font-size: 22px; margin-bottom: 24px; }
  .nav-center, .nav-actions { display: none; }
  .burger { display: flex; }
  .nav-center.open {
    display: flex; flex-direction: column;
    position: absolute; top: 56px; left: 0; right: 0;
    background: #fff; border-bottom: 1px solid var(--gray-bd);
    box-shadow: 0 8px 24px rgba(0,0,0,.12);
    padding: 10px 16px 16px; gap: 2px; z-index: 999;
  }
  .db-top { grid-template-columns: 1fr; }
  .db-metric + .db-metric {
    border-left: none; padding-left: 0;
    border-top: 1px solid var(--gray-bd); padding-top: 14px; margin-top: 14px;
  }
  .db-charts { grid-template-columns: 1fr; }
  .db-chart-panel { border-right: none; border-top: 1px solid var(--gray-bd); }
  .about-grid { grid-template-columns: 1fr; gap: 24px; }
  .plans-grid { grid-template-columns: 1fr; }
  .features-grid3 { grid-template-columns: 1fr; gap: 12px; }
  .reviews-row { grid-template-columns: 1fr; }
  .footer-grid { grid-template-columns: 1fr 1fr; gap: 20px; }
}

</style>
</head>
<body>

